# Settings for the Python agents (python -m agents.generate). Copy this file
# to .env and fill it in. .env is never committed, so your API key stays on
# this computer.

# Which AI provider writes the posts: openai, gemini, groq, anthropic or custom.
LLM_PROVIDER=gemini

# The API key for that provider. You only need the one you use.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For the Research agent's web search: a key from https://app.tavily.com
# (free tier available). Without it, posts use only the facts in brand/facts.md.
TAVILY_API_KEY=

# Optional: a different model from the provider's default (see README.md).
# LLM_MODEL=

# For "custom": any service that speaks OpenAI's API, such as OpenRouter or a
# local Ollama.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.3
